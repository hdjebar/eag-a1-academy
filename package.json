{
  "name": "eag-a1-academy",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:bank": "node scripts/build-bank.mjs",
    "promote:candidate": "node scripts/promote-candidate.mjs",
    "generate:bank": "node --env-file-if-exists=.env scripts/generate-bank.mjs",
    "review:bank": "node --env-file-if-exists=.env scripts/review-bank.mjs",
    "validate:bank": "node scripts/validate-bank.mjs",
    "test": "node --check app.js && node scripts/validate-bank.mjs --self-test && node scripts/validate-bank.mjs data/approved/*.json && node scripts/build-bank.mjs --check"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
