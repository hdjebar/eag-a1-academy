{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EAG A1 candidate question",
  "type": "object",
  "required": ["id", "category", "skill", "difficulty", "language", "prompt", "stimulus", "options", "correctIndex", "explanation", "sourceType", "reviewStatus"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z]+-[a-z0-9-]+-[0-9]{3,}$"},
    "category": {"enum": ["abstract", "verbal", "numeric", "planning", "situational"]},
    "skill": {"type": "string", "minLength": 3},
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
    "language": {"const": "fr"},
    "prompt": {"type": "string", "minLength": 12},
    "stimulus": {"type": ["string", "null"]},
    "options": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "correctIndex": {"type": "integer", "minimum": 0, "maximum": 3},
    "explanation": {"type": "string", "minLength": 12},
    "sourceType": {"const": "original_ai_assisted"},
    "reviewStatus": {"enum": ["candidate", "pending_human", "approved", "rejected"]}
  },
  "additionalProperties": false
}
